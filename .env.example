# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=casting.creativheads.com,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://casting.creativheads.com,http://localhost:8080
APP_BASE_URL=https://casting.creativheads.com
# Set to 0 only if you run without HTTPS (e.g. testing on http://localhost)
SECURE_COOKIES=1
TIME_ZONE=Asia/Kolkata
KEEP_MASTER_IMAGES=1
SESSION_IDLE_HOURS=8

# --- Database ---
POSTGRES_DB=casting
POSTGRES_USER=casting
POSTGRES_PASSWORD=change-me

# --- Email (password reset links) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@creativheads.com
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=CreativHeads Casting <no-reply@creativheads.com>

# --- Web ---
HTTP_PORT=8080

# --- Backups (FR-022) ---
# Long random passphrase. Store a copy OFF the server (password manager); without it backups can't be restored.
BACKUP_ENCRYPTION_KEY=
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=30
# rclone remote:path for the off-site copy (see deploy/backup/rclone.conf.example)
BACKUP_REMOTE=
# Optional dead-man's-switch URL (e.g. healthchecks.io) pinged on success, /fail on failure
BACKUP_HEALTHCHECK_URL=
