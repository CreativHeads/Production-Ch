# Copy to .env on the VPS (chmod 600). Never commit the real file.
SITE_DOMAIN=production.creativheads.com
APP_BASE_URL=https://production.creativheads.com
SECRET_KEY=change-me-long-random
SECURE_COOKIES=1
APP_DEBUG=0
TIME_ZONE=Asia/Kolkata

DB_NAME=casting
DB_USER=casting
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Only read on first boot, while the users table is empty.
ADMIN_USERNAME=admin
ADMIN_NAME=Studio Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional SMTP for password reset emails.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
