{$SITE_DOMAIN} {
	encode gzip
	request_body {
		max_size 100MB
	}
	reverse_proxy casting-app:3000
}

# Ad Reports (deployed from /opt/ad-reports, joined to this network as "ad-reports").
ads.creativheads.com {
	encode gzip
	reverse_proxy ad-reports:3000
}

# Cue content tracker (deployed from /opt/cue, joined to this network as "cue-tracker").
cue.creativheads.com {
	encode gzip
	reverse_proxy cue-tracker:3000
}
